generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization ───────────────────────────────────────────
model Organization {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  logoUrl            String?
  color              String?
  industry           String?
  usageContext       String?
  referralSource     String?
  phoneNumber        String?
  featureInterests   String[]
  onboardingComplete Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  departments        Department[]
  brands             Brand[]
  members            Member[]
  projects           Project[]
  documents          Document[]
  integrations       Integration[]
  products           Product[]
  transitionSkus     TransitionSku[]
  invites            OrganizationInvite[]
}

// ─── Session ────────────────────────────────────────────────
// Owned and created at runtime by connect-pg-simple (`createTableIfMissing`),
// not by Prisma. It is declared here anyway because `prisma db push` drops any
// table it does not know about — and scripts/post-merge.sh runs db push after
// every merge, so this table was being destroyed automatically and logging
// every user out, several times a week.
//
// The shape must match connect-pg-simple exactly or db push will "correct" the
// table into something the session store cannot use:
//   sid    varchar        primary key
//   sess   json           (not jsonb — the library writes json)
//   expire timestamp(6)   without time zone
// Prisma never reads or writes this model; it exists so db push leaves it alone.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ─── Organization Invite ────────────────────────────────────
model OrganizationInvite {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  invitedEmail String
  role         String       @default("member")
  invitedBy    String
  inviter      Member       @relation(fields: [invitedBy], references: [id])
  token        String       @unique
  status       String       @default("pending") // pending, accepted, expired
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  @@index([orgId])
  @@index([token])
}

// ─── Member ─────────────────────────────────────────────────
model Member {
  id               String               @id @default(cuid())
  clerkUserId      String               @unique
  email            String               @unique
  name             String
  avatar           String?
  role             String               @default("MEMBER") // ADMIN, OPS_MANAGER, DEPT_LEAD, PROJECT_LEAD, MEMBER
  status           String               @default("AVAILABLE") // AVAILABLE, FOCUSED, IN_MEETING, OOO
  orgId            String
  org              Organization         @relation(fields: [orgId], references: [id])
  departmentId     String?
  department       Department?          @relation(fields: [departmentId], references: [id])
  activities       Activity[]
  tasksOwned       Task[]               @relation("TaskOwner")
  notes            Note[]
  invitesSent      OrganizationInvite[]
  microsoftAccount MicrosoftAccount?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // ── Projects & Initiatives back-relations ──
  projectsManaged    Project[]           @relation("ProjectManager")
  projectsSponsored  Project[]           @relation("ProjectSponsor")
  projectMemberships ProjectMember[]
  lanesLed           ProjectDepartment[] @relation("LaneLead")
  milestonesOwned    ProjectMilestone[]  @relation("MilestoneOwner")
  tasksRequested     Task[]              @relation("TaskRequester")
  checkinsAnswered   ProjectCheckin[]    @relation("CheckinRespondent")
  reportsGenerated   ProjectReport[]     @relation("ReportAuthor")
  risksOwned         ProjectRisk[]       @relation("RiskOwner")
  projectComments    ProjectComment[]    @relation("CommentAuthor")
  projectActivity    ProjectActivity[]   @relation("ActivityActor")
  collabLinksMade    CollabProjectLink[] @relation("CollabLinker")
  collabLinksRemoved CollabProjectLink[] @relation("CollabUnlinker")
  chatLinksMade      TaskChatLink[]      @relation("ChatLinker")

  // ── User Management ──
  // `role` above stays the authority for the projects module. `roleId` is the
  // new permission system; Role.legacyRole keeps the two in step on write.
  roleId             String?
  roleRef            Role?               @relation(fields: [roleId], references: [id])
  /// invited | active | suspended | deactivated. Distinct from `status`, which
  /// is presence (AVAILABLE/FOCUSED/IN_MEETING/OOO).
  lifecycleStatus    String              @default("active")
  displayName        String?
  jobTitle           String?
  phone              String?
  timezone           String              @default("America/New_York")
  locale             String              @default("en-CA")
  emailVerifiedAt    DateTime?
  /// Holds the new address during an email change; promoted on verification.
  pendingEmail       String?
  lastLoginAt        DateTime?
  deactivatedAt      DateTime?
  createdById        String?
  createdBy          Member?             @relation("MemberCreator", fields: [createdById], references: [id])
  createdMembers     Member[]            @relation("MemberCreator")

  preference           UserPreference?
  notificationPrefs    NotificationPreference[]
  permissionOverrides  UserPermissionOverride[] @relation("OverrideSubject")
  overridesGranted     UserPermissionOverride[] @relation("OverrideGrantor")
  invitationsSentNew   UserInvitation[]         @relation("InvitationSender")
  auditEntries         AuditLog[]               @relation("AuditActor")

  @@index([orgId])
  @@index([clerkUserId])
}

// ─── Department ─────────────────────────────────────────────
model Department {
  id          String             @id @default(cuid())
  name        String
  // Stable machine identifier (OPERATIONS, R_AND_D, ...). `type` only
  // distinguishes builtin-vs-custom and repeats across custom departments, so
  // it cannot be used to reference a specific department from config or seeds.
  // Nullable because departments created before this column exist; the seed
  // backfills the known ones and new departments derive one from their name.
  code        String?            @unique
  description String?
  icon        String             @default("circle")
  color       String             @default("#0A84FF")
  type        String             @default("CUSTOM") // BUILTIN_RD, BUILTIN_OPS, BUILTIN_FINANCE, CUSTOM
  orgId       String
  org         Organization       @relation(fields: [orgId], references: [id])
  members     Member[]
  modules     DepartmentModule[]
  tasks       Task[]
  archived    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // ── Projects & Initiatives ──
  projectTypeDefaults ProjectType[]
  ownedProjects       Project[]           @relation("ProjectOwnerDept")
  projectLanes        ProjectDepartment[]
  projectMemberships  ProjectMember[]
  projectPhases       ProjectPhase[]
  projectMilestones   ProjectMilestone[]
  projectCheckins     ProjectCheckin[]
  projectReports      ProjectReport[]
  projectRisks        ProjectRisk[]
  projectComments     ProjectComment[]
  projectActivity     ProjectActivity[]
  projectTemplates    ProjectTemplate[]

  @@index([orgId])
}

// ─── Department Module ──────────────────────────────────────
model DepartmentModule {
  id           String       @id @default(cuid())
  name         String
  type         String // BRIEFS, CM_PRODUCTIVITY, TECH_TRANSFERS, FORMULATIONS, NPD_PIPELINE, ARTWORK, COMPONENTS, BILL_OF_MATERIALS, FINANCE_COSTING, SKU_PIPELINE, INVENTORY_HEALTH, PRODUCTION_TRACKING, BRAND_TRANSITION, CUSTOM_TABLE, CUSTOM_KANBAN, CUSTOM_LIST
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  config       Json         @default("{}")
  items        ModuleItem[]
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([departmentId])
}

// ─── Module Item ────────────────────────────────────────────
model ModuleItem {
  id        String           @id @default(cuid())
  moduleId  String
  module    DepartmentModule @relation(fields: [moduleId], references: [id])
  data      Json
  status    String?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([moduleId])
}

// ─── Brand ──────────────────────────────────────────────────
model Brand {
  id    String       @id @default(cuid())
  name  String
  color String
  icon  String
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// ─── Product ────────────────────────────────────────────────
model Product {
  id           String       @id @default(cuid())
  name         String
  brand        String
  category     String
  sku          String?      @unique
  upc          String?
  description  String?
  retailPrice  String?
  cogs         String?
  status       String       @default("ACTIVE") // ACTIVE, IN_DEVELOPMENT, DISCONTINUED
  imageUrl     String?
  weight       String?
  dimensions   String?
  ingredients  String?
  manufacturer String?
  variants     Json?
  kareveId     String?      @unique
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId])
  @@index([status])
}

// ─── Project (Projects & Initiatives) ───────────────────────
// Extended in place rather than duplicated into a parallel `projects` table.
// Task, CoworkSpace, the dashboard and the escalation worker already point
// here, so a second project/task pair would give Nexus two sources of truth —
// the one thing the initiative must not do.
//
// Back-compat notes for existing rows:
//  - `health` stays an Int score (0-100). `healthBand` is the derived
//    GREEN/AMBER/RED cache. The original column keeps its meaning.
//  - `priority` accepts both the legacy P0-P3 values and the new
//    CRITICAL/HIGH/MEDIUM/LOW. normalizePriority() in the service layer reads
//    either; the seed backfills legacy rows.
model Project {
  id               String       @id @default(cuid())
  // Human reference, PRJ-YYYY-NNNN. Nullable for the rows that predate it.
  projectNumber    String?      @unique
  title            String
  description      String?
  status           String       @default("ACTIVE")
  // DRAFT | PROPOSED | APPROVED | ACTIVE | ON_HOLD | AT_RISK | BLOCKED
  // | COMPLETED | CANCELLED | ARCHIVED  (legacy: REVIEW, COMPLETE)
  priority         String       @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW (legacy P0-P3)
  health           Int          @default(100) // 0-100 score, cached
  healthBand       String       @default("GREEN") // GREEN | AMBER | RED, derived from health
  healthComputedAt DateTime?
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  leadId           String?

  // ── Classification & ownership ──
  projectTypeId      String?
  projectType        ProjectType? @relation(fields: [projectTypeId], references: [id])
  ownerDepartmentId  String?
  ownerDepartment    Department?  @relation("ProjectOwnerDept", fields: [ownerDepartmentId], references: [id])
  projectManagerId   String?
  projectManager     Member?      @relation("ProjectManager", fields: [projectManagerId], references: [id])
  executiveSponsorId String?
  executiveSponsor   Member?      @relation("ProjectSponsor", fields: [executiveSponsorId], references: [id])

  // ── Business framing ──
  businessCase    String?
  successCriteria String?
  lessonsLearned  String? // required before ARCHIVED, enforced in the service layer
  brands          String[] @default([])
  retailers       String[] @default([])
  markets         String[] @default([])

  // ── Dates. baselineEndDate is frozen at approval and never auto-changes;
  //    slip is always measured against it. ──
  startDate       DateTime?
  targetEndDate   DateTime?
  baselineEndDate DateTime?
  actualEndDate   DateTime?
  baselinedAt     DateTime?

  percentComplete Decimal  @default(0) @db.Decimal(5, 2) // rolled up from tasks
  budgetAmount    Decimal? @db.Decimal(14, 2)
  actualSpend     Decimal? @db.Decimal(14, 2)
  currency        String   @default("USD")
  customFields    Json     @default("{}")

  // ── Check-in cadence (drives the project manager engine) ──
  checkinCadence   String    @default("WEEKLY") // DAILY | WEEKLY | BIWEEKLY | MONTHLY | NONE
  checkinDayOfWeek Int? // 1=Mon ... 5=Fri
  nextCheckinAt    DateTime?
  lastActivityAt   DateTime?

  isConfidential Boolean @default(false) // restricts visibility to explicit members

  // Monotonic per-project task sequence (#17). Incremented atomically on task
  // create; never reused, so a deleted #4 leaves a gap rather than colliding.
  taskCounter Int @default(0)

  tasks       Task[]
  coworkSpace CoworkSpace?
  departments ProjectDepartment[]
  members     ProjectMember[]
  phases      ProjectPhase[]
  milestones  ProjectMilestone[]
  checkins    ProjectCheckin[]
  reports     ProjectReport[]
  healthSnapshots ProjectHealthSnapshot[]
  risks       ProjectRisk[]
  comments    ProjectComment[]
  activity    ProjectActivity[]
  moduleLinks ProjectModuleLink[]
  collabLinks CollabProjectLink[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // The default list query is `orgId + not deleted, newest first`. Without a
  // composite covering it, the busiest view in the module sorts the whole
  // table on every page load.
  @@index([orgId, deletedAt, updatedAt(sort: Desc)])
  @@index([orgId])
  @@index([ownerDepartmentId])
  @@index([status])
  @@index([projectManagerId])
  @@index([nextCheckinAt])
  // One per remaining list filter and sort key (§5): type, health, priority,
  // target date. Each was a sequential scan before.
  @@index([projectTypeId])
  @@index([healthBand])
  @@index([priority])
  @@index([targetEndDate])
  // brands/retailers are text[] filtered with `has`; only GIN serves that.
  @@index([brands], type: Gin)
  @@index([retailers], type: Gin)
}

// ─── Project Type ───────────────────────────────────────────
// Taxonomy as data, not an enum. Adding a 15th type is an insert.
model ProjectType {
  id                  String            @id @default(cuid())
  code                String            @unique
  label               String
  defaultDepartmentId String?
  defaultDepartment   Department?       @relation(fields: [defaultDepartmentId], references: [id])
  icon                String?
  description         String?
  // Field keys the create wizard must require for this type, e.g.
  // ["savingsTarget"] on COST_SAVINGS. Validated server-side against
  // Project.customFields.
  requiredFields      String[]          @default([])
  defaultTemplateId   String?
  sortOrder           Int               @default(0)
  isActive            Boolean           @default(true)
  projects            Project[]
  templates           ProjectTemplate[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// ─── Participating departments (the "same module everywhere" mechanism) ──
// A project is one row; each department sees it through its own lane. This
// table is what makes a project appear in a second department's Projects tab
// without copying anything.
model ProjectDepartment {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  role         String     @default("CONTRIBUTOR") // OWNER | CONTRIBUTOR | REVIEWER | VIEWER
  laneLeadId   String?
  laneLead     Member?    @relation("LaneLead", fields: [laneLeadId], references: [id])
  joinedAt     DateTime   @default(now())
  // Which collab link put this lane on the project, if any. Unlinking must
  // revoke the access it granted without touching lanes a person added
  // deliberately — without provenance the two are indistinguishable and unlink
  // has to choose between leaving stale access or deleting real work.
  addedByLinkId String?
  addedByLink   CollabProjectLink? @relation("LinkedDepartments", fields: [addedByLinkId], references: [id], onDelete: SetNull)

  @@unique([projectId, departmentId])
  @@index([departmentId])
  @@index([addedByLinkId])
}

// ─── Individual members (overrides + confidential projects) ─
model ProjectMember {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member      @relation(fields: [memberId], references: [id])
  role         String      @default("CONTRIBUTOR")
  // PROJECT_MANAGER | LANE_LEAD | CONTRIBUTOR | REVIEWER | VIEWER | SPONSOR
  departmentId String? // which lane they act in
  department   Department? @relation(fields: [departmentId], references: [id])
  isWatcher    Boolean     @default(false)
  addedAt      DateTime    @default(now())
  // Same provenance rule as ProjectDepartment: a membership granted by a collab
  // link is revoked when that link goes away, one added by hand is not.
  addedByLinkId String?
  addedByLink   CollabProjectLink? @relation("LinkedMembers", fields: [addedByLinkId], references: [id], onDelete: SetNull)

  @@unique([projectId, memberId])
  @@index([memberId])
  @@index([addedByLinkId])
}

// ─── Timeline ───────────────────────────────────────────────
model ProjectPhase {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  sequence      Int
  departmentId  String?
  department    Department?        @relation(fields: [departmentId], references: [id])
  startDate     DateTime?
  endDate       DateTime?
  baselineStart DateTime?
  baselineEnd   DateTime?
  actualStart   DateTime?
  actualEnd     DateTime?
  status        String             @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETE | BLOCKED | SKIPPED
  colorHex      String?
  tasks         Task[]
  milestones    ProjectMilestone[]

  @@unique([projectId, sequence])
  @@index([projectId])
}

model ProjectMilestone {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId       String?
  phase         ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  dueDate       DateTime
  baselineDate  DateTime?
  completedDate DateTime?
  ownerId       String?
  owner         Member?       @relation("MilestoneOwner", fields: [ownerId], references: [id])
  departmentId  String?
  department    Department?   @relation(fields: [departmentId], references: [id])
  isGate        Boolean       @default(false) // hard stage gate: blocks downstream
  status        String        @default("PENDING") // PENDING | AT_RISK | MISSED | COMPLETE
  tasks         Task[]

  @@index([projectId])
  @@index([dueDate])
}

// ─── Cowork Space ───────────────────────────────────────────
model CoworkSpace {
  id           String              @id @default(cuid())
  name         String
  description  String?
  type         String              @default("PROJECT") // PROJECT, EMERGENCY, INITIATIVE, DEPARTMENT
  status       String              @default("ACTIVE") // ACTIVE, ARCHIVED
  projectId    String?             @unique
  project      Project?            @relation(fields: [projectId], references: [id])
  deptNames    String[]
  memberIds    String[]
  metadata     Json?
  activities   Activity[]
  tasks        Task[]              @relation("CoworkTasks")
  documents    Document[]          @relation("CoworkDocs")
  emails       EmailLink[]
  // Many-to-many project links. The legacy `projectId` one-to-one above stays
  // for back-compat; new links go through CollabProjectLink.
  projectLinks CollabProjectLink[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// ─── Task ───────────────────────────────────────────────────
// ─── Task ───────────────────────────────────────────────────
// The single task entity for all of Nexus. Project work adds scheduling and
// lane fields here rather than in a parallel project_tasks table, so a task
// completed anywhere — collab board, department tab, my-work queue — is the
// same row and updates everywhere at once.
//
// `departmentId` IS the lane. It is nullable for legacy/non-project tasks but
// required by the service layer for any task attached to a project.
model Task {
  id           String        @id @default(cuid())
  // Per-project sequence (#17). Null for tasks with no project.
  taskNumber   Int?
  title        String
  description  String?
  status       String        @default("NOT_STARTED")
  // NOT_STARTED | IN_PROGRESS | IN_REVIEW | BLOCKED | COMPLETE | CANCELLED
  // (spec's TODO/DONE map onto NOT_STARTED/COMPLETE — the existing vocabulary wins)
  priority     String        @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  effort       String? // XS, S, M, L, XL
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  brandNames   String[]
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])
  ownerId      String?
  owner        Member?       @relation("TaskOwner", fields: [ownerId], references: [id])
  coworkSpaces CoworkSpace[] @relation("CoworkTasks")
  documents    Document[]    @relation("TaskDocs")
  emails       EmailLink[]
  chatLinks    TaskChatLink[]
  notes        Note[]
  parentId     String?
  parent       Task?         @relation("SubTasks", fields: [parentId], references: [id])
  subtasks     Task[]        @relation("SubTasks")

  // ── Project scheduling ──
  phaseId         String?
  phase           ProjectPhase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  estimatedHours  Decimal?          @db.Decimal(7, 2)
  actualHours     Decimal?          @db.Decimal(7, 2)
  percentComplete Int               @default(0)
  blockedReason   String?
  blockedSince    DateTime?
  sortOrder       Int               @default(0)
  tags            String[]          @default([])

  // ── Cross-department requests ──
  // A task raised by department A in department B's lane arrives pending
  // acceptance. B's lane lead accepts (it becomes normal work) or rejects with
  // a reason. This is what stops one department dumping work on another.
  isCrossDept      Boolean   @default(false)
  requestedById    String?
  requestedBy      Member?   @relation("TaskRequester", fields: [requestedById], references: [id])
  acceptanceStatus String? // PENDING | ACCEPTED | REJECTED (null = not a request)
  acceptanceNote   String?
  acceptedAt       DateTime?

  dependenciesOut TaskDependency[]    @relation("Predecessor")
  dependenciesIn  TaskDependency[]    @relation("Successor")
  checklist       TaskChecklistItem[]
  projectComments ProjectComment[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([projectId, taskNumber])
  @@index([projectId])
  // Every task read filters deletedAt; the board and the rollup both pull a
  // whole project's tasks at once, so the pair is the shape that actually runs.
  @@index([projectId, deletedAt])
  @@index([departmentId])
  @@index([ownerId])
  @@index([status])
  @@index([projectId, departmentId])
  @@index([dueDate])
}

// ─── Task dependencies ──────────────────────────────────────
// Drives the critical path. Inserts are rejected when they would create a
// cycle (including indirect A->B->C->A), checked before write.
model TaskDependency {
  id             String   @id @default(cuid())
  predecessorId  String
  predecessor    Task     @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId    String
  successor      Task     @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)
  dependencyType String   @default("FS") // FS | SS | FF | SF
  lagDays        Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([predecessorId, successorId])
  @@index([successorId])
}

model TaskChecklistItem {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  isDone    Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([taskId])
}

// ─── Activity ───────────────────────────────────────────────
model Activity {
  id            String       @id @default(cuid())
  type          String // UPDATE, SUBMISSION, NOTE, STATUS_CHANGE, FILE_UPLOAD, EMAIL_LINKED, TASK_CREATED, TASK_COMPLETED, AI_ACTION
  content       String
  coworkSpaceId String?
  coworkSpace   CoworkSpace? @relation(fields: [coworkSpaceId], references: [id])
  authorId      String
  author        Member       @relation(fields: [authorId], references: [id])
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([coworkSpaceId])
  @@index([authorId])
}

// ─── Document ───────────────────────────────────────────────
model Document {
  id           String        @id @default(cuid())
  name         String
  mimeType     String
  size         Int
  storageKey   String
  storageUrl   String?
  type         String        @default("OTHER") // BRIEF, COA, SPEC_SHEET, QUOTE, PRICING, CONTRACT, REPORT, ARTWORK, INVOICE, OTHER
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id])
  uploadedById String
  coworkSpaces CoworkSpace[] @relation("CoworkDocs")
  tasks        Task[]        @relation("TaskDocs")
  version      Int           @default(1)
  parentDocId  String?
  createdAt    DateTime      @default(now())

  @@index([orgId])
  @@index([type])
}

// ─── Email Link ─────────────────────────────────────────────
model EmailLink {
  id            String       @id @default(cuid())
  messageId     String
  subject       String
  fromAddr      String
  toAddrs       String[]
  date          DateTime
  snippet       String?
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id])
  coworkSpaceId String?
  coworkSpace   CoworkSpace? @relation(fields: [coworkSpaceId], references: [id])
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([taskId])
  @@index([coworkSpaceId])
}

// ─── Teams chat linked to a task ────────────────────────────
// EmailLink already covers mail. A Teams chat is a different shape — no
// subject, no from/to, a rolling conversation rather than a message — so it
// gets its own table instead of nullable columns on a model that means
// something else.
//
// Only the identifiers and enough display text to render the list are stored.
// The messages themselves stay in Teams and are fetched per view: caching them
// would mean showing an edited or deleted message as if it still stood.
model TaskChatLink {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Microsoft Graph chat id.
  chatId      String
  /// Group chat name. Null for a 1:1, which Teams titles by its members.
  topic       String?
  chatType    String // oneOnOne | group | meeting
  /// Cached for display so the list needs no Graph call per row.
  memberNames String[]
  linkedById  String?
  linkedBy    Member?  @relation("ChatLinker", fields: [linkedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([taskId, chatId])
  @@index([taskId])
}

// ─── Note ───────────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    Member   @relation(fields: [authorId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

// ─── Integration ────────────────────────────────────────────
model Integration {
  id         String       @id @default(cuid())
  type       String // ERP_KAREVE_SYNC, MICROSOFT_OUTLOOK, MICROSOFT_TEAMS, MICROSOFT_ONEDRIVE, AMAZON_VENDOR_CENTRAL, SHOPIFY, GS1_SYNC, SLACK, ZAPIER
  name       String
  status     String       @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR, SYNCING
  config     Json         @default("{}")
  lastSyncAt DateTime?
  syncCount  Int          @default(0)
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  syncLogs   SyncLog[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([orgId])
}

// ─── Sync Log ───────────────────────────────────────────────
model SyncLog {
  id               String      @id @default(cuid())
  integrationId    String
  integration      Integration @relation(fields: [integrationId], references: [id])
  status           String
  recordsProcessed Int         @default(0)
  errors           Json?
  startedAt        DateTime    @default(now())
  completedAt      DateTime?

  @@index([integrationId])
}

// ─── Pulse ──────────────────────────────────────────────────
model Pulse {
  id        String   @id @default(cuid())
  type      String // ALERT, SIGNAL, HEARTBEAT, BROADCAST
  message   String
  deptName  String?
  targetId  String?
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([read])
}

// ─── Email Agent Log ────────────────────────────────────────
model EmailAgentLog {
  id               String    @id @default(cuid())
  messageId        String    @unique
  senderEmail      String
  subject          String
  status           String    @default("processing") // processing, complete, partial, parse_error, awaiting_clarification
  parsedPlan       Json?
  executionResults Json?
  error            String?
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([senderEmail])
  @@index([status])
}

// ─── Escalation Rule ────────────────────────────────────────
model EscalationRule {
  id           String   @id @default(cuid())
  trigger      String
  action       String
  targetRole   String?
  delayMinutes Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ─── Brand Transition SKU ───────────────────────────────────
model TransitionSku {
  id                    String                @id @default(cuid())
  materialCode          String                @unique
  description           String
  brand                 String                @default("CarolsDaughter")
  track                 String // loreal_coman, full_buy, disco_decision
  currentCm             String?
  lorealEntity          String?
  manufacturingProcess  String?
  transitionDeadline    DateTime?             @default(dbgenerated("'2025-04-29'::timestamp"))
  newCm                 String?
  cmStatus              String                @default("Not Started")
  cmOutreachDate        DateTime?
  cmAgreementDate       DateTime?
  firstProductionDate   DateTime?
  transitionOwner       String?
  formulaTransferred    Boolean               @default(false)
  formulaTransferDate   DateTime?
  formulaOwner          String?
  rawMaterialsConfirmed Boolean               @default(false)
  rmNotes               String?
  discoDecision         String                @default("Pending") // Pending, Discontinue, Find RM and Produce
  discoDecisionDate     DateTime?
  discoDecisionOwner    String?
  rmDisengaged          String?
  lastLorealBatches     Int                   @default(0)
  lastBatchEta          DateTime?
  currentInventoryUnits Int                   @default(0)
  weeksOfSupply         Float?
  avgWeeklyVelocity     Float?
  overallStatus         String                @default("Needs Action") // Active, Needs Action, At Risk, Decision Required, Discontinued, Transition Complete
  isFlagged             Boolean               @default(false)
  priority              String                @default("Medium") // High, Medium, Low
  isCowork              Boolean               @default(false)
  coworkType            String?
  coworkNote            String?
  coworkAssignedTo      String?
  coworkResolved        Boolean               @default(false)
  notes                 String?
  orgId                 String
  org                   Organization          @relation(fields: [orgId], references: [id])
  transitionNotes       TransitionNote[]
  milestones            TransitionMilestone[]
  cmCandidates          CmCandidate[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([orgId])
  @@index([track])
  @@index([overallStatus])
}

// ─── Transition Note ────────────────────────────────────────
model TransitionNote {
  id        String        @id @default(cuid())
  skuId     String
  sku       TransitionSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  noteType  String        @default("Update") // Update, CM Outreach, Legal / Agreement, Formula Transfer, RM Update, Decision, CoWork, System
  noteText  String
  createdBy String?
  createdAt DateTime      @default(now())

  @@index([skuId])
}

// ─── Transition Milestone ───────────────────────────────────
model TransitionMilestone {
  id            String        @id @default(cuid())
  skuId         String
  sku           TransitionSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  milestoneName String
  dueDate       DateTime?
  completed     Boolean       @default(false)
  completedDate DateTime?
  completedBy   String?
  notes         String?

  @@index([skuId])
}

// ─── CM Candidate ───────────────────────────────────────────
model CmCandidate {
  id               String        @id @default(cuid())
  skuId            String
  sku              TransitionSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  cmName           String
  cmContact        String?
  cmEmail          String?
  capability       String?
  outreachDate     DateTime?
  responseReceived Boolean       @default(false)
  responseDate     DateTime?
  quoteReceived    Boolean       @default(false)
  quoteAmount      Float?
  status           String        @default("Under Evaluation") // Under Evaluation, Qualified, Rejected, Selected
  rejectionReason  String?
  notes            String?
  createdAt        DateTime      @default(now())

  @@index([skuId])
}

// ─── Attachment (polymorphic) ────────────────────────────────
model Attachment {
  id             String    @id @default(cuid())
  attachableType String // task, formulation, tech_transfer, tech_transfer_stage, product, brief, component
  attachableId   String // ID of the parent entity
  module         String? // npd, active_brief, cm_productivity, etc. (for task-scoped attachments)
  type           String // email, file, comment
  payload        Json // type-specific data
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([attachableType, attachableId])
  @@index([createdAt(sort: Desc)])
}

// ─── Tech Transfer Stage ────────────────────────────────────
model TechTransferStage {
  id             String                  @id @default(cuid())
  techTransferId String // references ModuleItem ID for the tech transfer
  stageOrder     Int
  stageName      String
  status         String                  @default("pending") // pending, in_progress, complete, blocked, skipped
  assigneeUserId String?
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  tasks          TechTransferStageTask[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([techTransferId])
  @@index([stageOrder])
}

// ─── Tech Transfer Stage Task ───────────────────────────────
model TechTransferStageTask {
  id             String            @id @default(cuid())
  stageId        String
  stage          TechTransferStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  taskName       String
  description    String?
  status         String            @default("not_started") // not_started, in_progress, complete, blocked
  assigneeUserId String?
  dueDate        DateTime?
  sortOrder      Int               @default(0)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([stageId])
}

// ─── Formulation Ingredient ─────────────────────────────────
model FormulationIngredient {
  id             String  @id @default(cuid())
  formulationId  String // references ModuleItem ID for the formulation
  phase          String // A, B, C, D, E, Post-Add
  sortOrder      Int     @default(0)
  inciName       String
  tradeName      String?
  supplierId     String?
  function       String? // emollient, surfactant, preservative, fragrance, active, chelator, etc.
  percentage     Float // % w/w, 4 decimals
  costPerKg      Float?
  isAllergen     Boolean @default(false)
  isPreservative Boolean @default(false)
  isFragrance    Boolean @default(false)
  notes          String?

  @@index([formulationId])
  @@index([phase])
}

// ─── Formulation Procedure Step ─────────────────────────────
model FormulationProcedureStep {
  id              String  @id @default(cuid())
  formulationId   String // references ModuleItem ID
  stepNumber      Int
  phaseReference  String? // which phase this step relates to
  instruction     String
  temperatureC    Float?
  mixingSpeedRpm  Int?
  durationMinutes Int?

  @@index([formulationId])
}

// ─── Microsoft Account (per-user Graph connection) ──────────
// Stores one connected Microsoft work account per member so NEXUS can read
// that user's own Outlook mail + OneDrive files on their behalf. Tokens are
// encrypted at rest (AES-256-GCM) in `tokenData`.
model MicrosoftAccount {
  id           String   @id @default(cuid())
  memberId     String   @unique
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accountEmail String
  accountName  String?
  tokenData    Json // encrypted { accessToken, refreshToken, expiresAt }
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([memberId])
}

// ─── Check-ins (the project manager engine) ─────────────────
// One row per participating department per cycle. Four questions only —
// anything longer does not get filled out.
model ProjectCheckin {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  departmentId String? // null = all-hands check-in
  department   Department? @relation(fields: [departmentId], references: [id])
  requestedAt  DateTime    @default(now())
  dueAt        DateTime
  respondedAt  DateTime?
  respondentId String?
  respondent   Member?     @relation("CheckinRespondent", fields: [respondentId], references: [id])
  status       String      @default("PENDING") // PENDING | RESPONDED | OVERDUE | SKIPPED

  progressSummary String?
  blockers        String?
  needsFromOthers String?
  confidence      String? // ON_TRACK | AT_RISK | OFF_TRACK

  reminderCount     Int       @default(0)
  lastReminderAt    DateTime?
  escalatedAt       DateTime? // escalated to PM
  sponsorNotifiedAt DateTime?

  // Idempotency for the hourly cron: running it twice in the same window must
  // not create a duplicate check-in for the same department and due time.
  @@unique([projectId, departmentId, dueAt])
  @@index([projectId])
  @@index([status, dueAt])
  // Compliance analytics and the report builders both window on requestedAt.
  @@index([projectId, requestedAt])
}

// ─── Reports ────────────────────────────────────────────────
// `payload` is a frozen snapshot taken at generation. A report produced last
// week must return identical content today, so nothing here is recomputed on
// read.
model ProjectReport {
  id                String      @id @default(cuid())
  projectId         String? // null = portfolio report
  project           Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportType        String
  // PROJECT_UPDATE | STATUS_UPDATE | EXECUTIVE_ROLLUP | DEPARTMENT_DIGEST | CLOSEOUT
  scopeDepartmentId String?
  scopeDepartment   Department? @relation(fields: [scopeDepartmentId], references: [id])
  periodStart       DateTime?
  periodEnd         DateTime?
  title             String
  narrative         String? // AI-drafted from payload, always human-editable
  // @db.Json (not jsonb) on purpose. jsonb normalises what it stores — it
  // reorders keys, collapses duplicates, and rewrites numbers — so a payload
  // read back would not be the bytes that were written. This column is a
  // frozen record of what a report said, nothing queries inside it, and the
  // exactness is the whole point.
  payload           Json        @db.Json
  generatedBy       String      @default("SYSTEM") // SYSTEM | USER | AGENT
  generatedByUserId String?
  generatedByUser   Member?     @relation("ReportAuthor", fields: [generatedByUserId], references: [id])
  isPublished       Boolean     @default(false)
  publishedAt       DateTime?
  distribution      Json        @default("[]")
  orgId             String
  createdAt         DateTime    @default(now())

  @@index([projectId])
  @@index([reportType, createdAt])
  @@index([orgId])
}

// ─── Health history ─────────────────────────────────────────
// One row per project per day, written by the nightly health sweep.
//
// A trend cannot be reconstructed from the activity feed: band changes are
// logged there only when health WORSENS, so a reconstruction would show every
// project declining and never recovering. This table is the honest source, and
// because it starts empty the trend endpoint reports how far back it actually
// reaches rather than drawing a flat line over days it knows nothing about.
model ProjectHealthSnapshot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Midnight America/New_York for the day being recorded, so a day is a
  // business day rather than a UTC one.
  day       DateTime
  score     Int
  band      String // GREEN | AMBER | RED
  status    String
  percentComplete Decimal @db.Decimal(5, 2)
  orgId     String
  createdAt DateTime @default(now())

  // One snapshot per project per day: the sweep is idempotent under re-runs.
  @@unique([projectId, day])
  @@index([orgId, day])
  @@index([day])
}

// ─── Risks / Issues / Decisions / Dependencies ──────────────
model ProjectRisk {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordType   String      @default("RISK") // RISK | ISSUE | DECISION | DEPENDENCY
  title        String
  detail       String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  ownerId      String?
  owner        Member?     @relation("RiskOwner", fields: [ownerId], references: [id])
  impact       String? // LOW | MEDIUM | HIGH | CRITICAL
  likelihood   String? // LOW | MEDIUM | HIGH
  mitigation   String?
  status       String      @default("OPEN") // OPEN | MITIGATING | RESOLVED | ACCEPTED
  dueDate      DateTime?
  resolvedAt   DateTime?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([projectId])
  @@index([status])
}

// ─── Comments ───────────────────────────────────────────────
model ProjectComment {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId     String
  author       Member      @relation("CommentAuthor", fields: [authorId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  body         String
  mentions     String[]    @default([])
  createdAt    DateTime    @default(now())
  editedAt     DateTime?
  deletedAt    DateTime?

  @@index([projectId])
  @@index([taskId])
}

// ─── Activity ───────────────────────────────────────────────
// Separate from the existing Activity model, which requires a non-null author
// and is cowork-scoped. Engine actions have no actor, so actorId is nullable
// here; SYSTEM rows are written with actorId = null.
model ProjectActivity {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        Member?     @relation("ActivityActor", fields: [actorId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  entityType   String // PROJECT | TASK | MILESTONE | PHASE | CHECKIN | RISK | COLLAB | REPORT
  entityId     String?
  action       String // CREATED | UPDATED | STATUS_CHANGED | ASSIGNED | ...
  fieldChanges Json? // { field: { from, to } }
  summary      String // human-readable feed line
  createdAt    DateTime    @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([departmentId])
}

// ─── Collab bridge ──────────────────────────────────────────
// Many-to-many, unlike the legacy CoworkSpace.projectId one-to-one which stays
// for back-compat. Linking grants participant access; unlinking revokes it and
// never deletes project data.
model CollabProjectLink {
  id             String      @id @default(cuid())
  coworkSpaceId  String
  coworkSpace    CoworkSpace @relation(fields: [coworkSpaceId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedById     String?
  linkedBy       Member?     @relation("CollabLinker", fields: [linkedById], references: [id])
  linkedAt       DateTime    @default(now())
  visibility     String      @default("FULL") // FULL | TASKS_ONLY | SUMMARY_ONLY
  autoAddMembers Boolean     @default(true)
  // Soft unlink. §2.4: detaching revokes access but never deletes project data,
  // so the row stays and records that the two were once connected. Relinking
  // reactivates this row — the unique constraint means a second row is not an
  // option anyway.
  unlinkedAt     DateTime?
  unlinkedById   String?
  unlinkedBy     Member?     @relation("CollabUnlinker", fields: [unlinkedById], references: [id])

  // Access this link granted, so unlink can revoke exactly that and no more.
  linkedDepartments ProjectDepartment[] @relation("LinkedDepartments")
  linkedMembers     ProjectMember[]     @relation("LinkedMembers")

  @@unique([coworkSpaceId, projectId])
  @@index([projectId])
}

// ─── Links to existing Nexus modules ────────────────────────
model ProjectModuleLink {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module    String
  // BRIEF | NPD | FORMULATION | ARTWORK | COMPONENT | TECH_TRANSFER
  // | PRODUCTION_ORDER | CM | DASHBOARD_SKU
  recordId  String
  label     String? // cached display label
  linkType  String   @default("RELATED") // SOURCE | OUTPUT | RELATED | BLOCKS
  createdAt DateTime @default(now())

  @@unique([projectId, module, recordId])
  @@index([module, recordId])
}

// ─── Templates ──────────────────────────────────────────────
// `definition` shape:
// { phases: [{name, sequence, offsetDays, durationDays, departmentCode}],
//   milestones: [{name, phaseSequence, offsetDays, isGate, departmentCode}],
//   tasks: [{title, phaseSequence, departmentCode, offsetDays, durationDays,
//            estimatedHours, dependsOn: [taskIndex]}] }
// Offsets are days from project start, so a template applies to any start date.
model ProjectTemplate {
  id            String       @id @default(cuid())
  name          String
  projectTypeId String?
  projectType   ProjectType? @relation(fields: [projectTypeId], references: [id])
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  description   String?
  definition    Json
  isActive      Boolean      @default(true)
  createdById   String?
  orgId         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectTypeId])
}

// ─── Project number allocation ───────────────────────────────
// PRJ-YYYY-NNNN is allocated from a per-org, per-year counter rather than
// MAX(projectNumber)+1, which races: two concurrent creates read the same max
// and both try to write the same number. The counter is incremented
// atomically inside the create transaction.
model ProjectNumberCounter {
  id        String   @id @default(cuid())
  orgId     String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([orgId, year])
}

// ═══════════════════════════════════════════════════════════
// User Management & Settings
// ═══════════════════════════════════════════════════════════
// The user table is `Member` above — it already carries 20+ relations across
// projects, tasks and reports, so this module extends it rather than
// introducing a parallel `users` table that half the app would not know about.
//
// Two collisions with the spec, resolved deliberately:
//   · `Member.status` already means PRESENCE (AVAILABLE/FOCUSED/OOO). Lifecycle
//     lives in `lifecycleStatus` so neither meaning is overloaded.
//   · `Member.role` is a legacy string read in 18+ places (policy.ts's
//     isOrgAdmin, task routes, report routes). It stays authoritative for
//     those; `roleId` is the new system, and Role.legacyRole is what keeps the
//     two in step. See rbac/resolve.ts.

/// A named bundle of permissions. System roles are seeded and immutable;
/// custom roles clone one as a starting point.
model Role {
  id          String   @id @default(cuid())
  /// Stable slug: owner | admin | manager | member | guest, or a custom key.
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  /// Lower is more powerful. An assigner may only grant a role of strictly
  /// higher rank than their own — the privilege-escalation guard.
  rank        Int
  /// The legacy `Member.role` string written whenever this role is assigned.
  ///
  /// The projects module reads that string directly and treats both ADMIN and
  /// OPS_MANAGER as org admin. Mapping `manager` onto OPS_MANAGER would have
  /// silently promoted every department lead to org admin the first time their
  /// profile was saved, so `manager` maps to DEPT_LEAD instead.
  legacyRole  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Member[]
  permissions RolePermission[]
  invitations UserInvitation[]

  @@index([rank])
}

/// Seeded catalogue. Never user-created — a permission with no code behind it
/// is a checkbox that lies.
model Permission {
  key         String   @id
  resource    String
  action      String
  label       String
  description String?
  sortOrder   Int      @default(0)

  roles       RolePermission[]
  overrides   UserPermissionOverride[]

  @@index([resource])
}

model RolePermission {
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

/// Per-user exception to their role. A deny always beats a grant.
model UserPermissionOverride {
  id            String     @id @default(cuid())
  memberId      String
  member        Member     @relation("OverrideSubject", fields: [memberId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  /// grant | deny
  effect        String
  grantedById   String?
  grantedBy     Member?    @relation("OverrideGrantor", fields: [grantedById], references: [id])
  /// Required. An override nobody can explain is one nobody dares remove.
  reason        String
  expiresAt     DateTime?
  createdAt     DateTime   @default(now())

  @@unique([memberId, permissionKey])
  @@index([memberId])
  @@index([expiresAt])
}

/// Invitation to join. Separate from the older OrganizationInvite, which the
/// onboarding flow still owns and which stores its token in plaintext.
model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  firstName   String?
  lastName    String?
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  departmentId String?
  message     String?
  /// SHA-256 of the raw token. The raw value exists only in the email — a
  /// database read must never be enough to accept someone else's invitation.
  tokenHash   String    @unique
  invitedById String?
  invitedBy   Member?   @relation("InvitationSender", fields: [invitedById], references: [id])
  orgId       String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([orgId])
}

model UserPreference {
  memberId           String   @id
  member             Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  theme              String   @default("system")
  density            String   @default("comfortable")
  defaultLandingPage String   @default("dashboard")
  weekStartsOn       Int      @default(1)
  dateFormat         String   @default("MMM d, yyyy")
  timeFormat         String   @default("12h")
  sidebarCollapsed   Boolean  @default(false)
  /// off | daily | weekly
  digestFrequency    String   @default("daily")
  /// Minutes from midnight in the member's own timezone, or null for none.
  quietHoursStart    Int?
  quietHoursEnd      Int?
  updatedAt          DateTime @updatedAt
}

/// One row per member per channel per event. A missing row means "use the
/// seeded default" — never "off". An event added later must not arrive
/// silently switched off for everyone who predates it.
model NotificationPreference {
  memberId String
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// in_app | email | digest
  channel  String
  eventKey String
  enabled  Boolean

  @@id([memberId, channel, eventKey])
  @@index([memberId])
}

/// Append-only. The repository exposes append() and query() and nothing else;
/// there is no update or delete path anywhere in the codebase.
model AuditLog {
  id                 String   @id @default(cuid())
  actorId            String?
  actor              Member?  @relation("AuditActor", fields: [actorId], references: [id])
  /// Denormalised so the trail still names someone after the actor is
  /// deactivated or their address changes.
  actorEmailSnapshot String?
  action             String
  entityType         String
  entityId           String?
  /// { field: { from, to } } — secrets redacted before write.
  changes            Json?
  /// ip, userAgent, requestId
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}
