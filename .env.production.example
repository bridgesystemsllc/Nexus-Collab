# Nexus Collab — Production Environment Configuration
# Copy to .env.production and fill in values. Never commit secrets.
#
# Variables marked [REQUIRED] must be set for the API to boot.
# Variables marked [OPTIONAL] enable specific features when set.
#
# In production, TOKEN_ENCRYPTION_KEY is enforced — the API refuses to start
# without it to prevent OAuth tokens from being encrypted with a dev key.

# ═══════════════════════════════════════════════════════════════
# CORE — REQUIRED FOR BOOT
# ═══════════════════════════════════════════════════════════════

# Database [REQUIRED]
# Cloud SQL / RDS connection string
DATABASE_URL=""

# Session security [REQUIRED]
# Generate with: openssl rand -hex 64
SESSION_SECRET=""

# Token encryption [REQUIRED] — API refuses to start without this in production
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════

NODE_ENV="production"
PORT=3000
FRONTEND_URL=""

# Background jobs trigger (32+ chars) [OPTIONAL]
# Required if using external cron trigger for jobs
# Generate with: openssl rand -hex 32
JOBS_TRIGGER_SECRET=""

# Redis for BullMQ worker [OPTIONAL]
# Required if running long-lived worker process
REDIS_URL=""

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION — MICROSOFT ENTRA
# ═══════════════════════════════════════════════════════════════

# Microsoft Graph / Entra ID [REQUIRED for SSO]
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI=""

# ═══════════════════════════════════════════════════════════════
# INTEGRATIONS
# ═══════════════════════════════════════════════════════════════

# Stripe billing [OPTIONAL — required for paid features]
# Use live keys in production
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
BILLING_PROVIDER="stripe"

# S3-compatible storage (Cloudflare R2) [OPTIONAL — required for file uploads]
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_PUBLIC_URL=""

# Meilisearch [OPTIONAL — required for search]
MEILI_URL=""
MEILI_MASTER_KEY=""

# AI / Anthropic [OPTIONAL — required for AI features]
ANTHROPIC_API_KEY=""

# Google OAuth [OPTIONAL]
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ERP Integration [OPTIONAL — required for ERP sync]
ERP_API_URL=""
ERP_API_KEY=""

# Email Agent [OPTIONAL — required for email integration]
AGENT_MAILBOX=""
AGENT_WEBHOOK_SECRET=""
AUTHORIZED_SENDERS=""
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""

# Formulations gate [OPTIONAL]
# Store sha256 hash of password only
FORMULATIONS_PASSWORD_HASH=""

# ═══════════════════════════════════════════════════════════════
# OBSERVABILITY
# ═══════════════════════════════════════════════════════════════

# Sentry error tracking [RECOMMENDED for production]
SENTRY_DSN=""

# Log level [OPTIONAL]
LOG_LEVEL="info"
